#!/bin/sh
# Pre-push hook. It runs no checks: run `npm run typecheck` and `npm test` yourself before sharing a change.
# It only carries the opt-in Pages publish step below, which does nothing unless `git config publish.onPush true`.
# Enabled by `npm install`, or by hand with `npm run setup:hooks` (scripts/setup-git-hooks.mjs sets core.hooksPath).

# pages-publish:begin
# Opt-in: publish the checked-out branch. Enable with
#   git config publish.onPush true
# A failed publish only warns; it never blocks the push.
if [ "$(git config --bool publish.onPush 2>/dev/null)" = "true" ]; then
  py=""
  for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then py="$candidate"; break; fi
  done
  "$py" .gittools/pages-publish/pages_publish.py publish >&2 || echo "pre-push: warning: publishing failed (the push continues)." >&2
fi
# pages-publish:end
