#!/bin/sh
# Generated by .agents/knowledge/install.py. In a linked worktree this uses the drop-in, environment and notes of the
# main checkout, even if the worktree has a copy of the drop-in: there is one store, written by one version of the tool.
case "${KNOWLEDGE_DISABLE:-}" in
  ""|0|[Ff][Aa][Ll][Ss][Ee]) ;;
  *) echo "know: disabled by KNOWLEDGE_DISABLE" >&2; exit 1 ;;
esac
root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$root/.git" ]; then
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$common" in */.git) root="${common%/.git}" ;; esac
fi
python="$root/.agents/.state/knowledge/venv/bin/python"
[ -x "$python" ] || python="$root/.agents/.state/knowledge/venv/Scripts/python.exe"
if [ ! -x "$python" ] || [ ! -f "$root/.agents/knowledge/knowledge.py" ]; then
  echo "know: not installed in $root; run: python \"$root/.agents/knowledge/install.py\", then _scripts/know_init (see .agents/knowledge/README.md)" >&2; exit 1
fi
exec "$python" "$root/.agents/knowledge/knowledge.py" brief "$@"
