#!/bin/sh
# Generated by .agents/agents-md/install.py.
root="$(cd "$(dirname "$0")/.." && pwd)"
script="$root/.agents/agents-md/agents-md.py"
if [ ! -f "$script" ]; then
  common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  script="${common%/.git}/.agents/agents-md/agents-md.py"
  AGENTS_MD_ROOT="$root"
  export AGENTS_MD_ROOT
fi
if [ ! -f "$script" ]; then
  echo "agents-md: the drop-in is not installed; copy its folder into .agents/ and run: python .agents/agents-md/install.py" >&2
  exit 1
fi
if command -v python3 >/dev/null 2>&1; then exec python3 "$script" "$@"; fi
if command -v python >/dev/null 2>&1; then exec python "$script" "$@"; fi
echo "agents-md: Python was not found on the PATH; install Python 3.11 or later and run this again" >&2
exit 1
